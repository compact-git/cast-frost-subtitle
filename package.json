{
  "name": "cast-frost-subtitle",
  "productName": "Cast Frost 字幕",
  "version": "0.4.8",
  "description": "Cast Frost Web の字幕を自分の画面に枠なし・透明・最前面で表示し、エフェクトの全体ホットキー、YouTube Live のチャットの読み取り、OBS 用の動画プレーヤー(フリップの Twitch 動画)を受け持つ補助アプリ",
  "main": "main.js",
  "author": "compact",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "jp.compact.castfrost.subtitle",
    "productName": "Cast Frost 字幕",
    "artifactName": "CastFrostSubtitle_v${version}.exe",
    "files": [
      "main.js",
      "youtube.js",
      "preload.js",
      "overlay.html",
      "overlay.js",
      "subrender.js",
      "overlay-fx.js",
      "fxengine.js",
      "twplay.js",
      "player.html",
      "tray.png",
      "tray@2x.png",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
